# ==============================================================================
# AI Provider Configuration (Aryan Presentation Creator)
# ==============================================================================
# Choose your active provider: "auto" (default), "openrouter", "cloudflare", or "gemini"
# "auto" will try your available keys in order with automatic fallback!
AI_PROVIDER=auto

# ------------------------------------------------------------------------------
# 1. OpenRouter (Alternative to Gemini: Llama 3.3, DeepSeek, Qwen, etc.)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Alternative cheap models:
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# ------------------------------------------------------------------------------
# 2. Cloudflare Workers AI (Serverless AI running on Cloudflare's Edge)
# ------------------------------------------------------------------------------
CLOUDFLARE_TOKEN_API=your-cloudflare-api-token
# Account ID is auto-extracted from CLOUDFLARE_JURISDICTION_SPECIFIC_ENDPOINT if present,
# or you can set it explicitly here:
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct
# Alternative models:
# CLOUDFLARE_AI_MODEL=@cf/deepseek-ai/deepseek-r1-distill-qwen-32b
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-70b-instruct

# ------------------------------------------------------------------------------
# 3. Google Gemini (Google AI Studio)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_MODEL=gemini-flash-lite-latest

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage (For presentation snippets & assets)
# ------------------------------------------------------------------------------
CLOUDFLARE_S3_ACCESS_KEY_ID=
CLOUDFLARE_S3_SECRET_ACCESS_KEY_ID=
CLOUDFLARE_JURISDICTION_SPECIFIC_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_PUBLIC_DEVELOPMENT_URL=https://pub-xxxxxx.r2.dev
CLOUDFLARE_R2_BUCKET_NAME=ppt
